# Shared ignore list for both Dockerfile (openstudy) and web/Dockerfile
# (frontend). The build contexts overlap on the repo root, so anything
# excluded here disappears from both builds.

# Python build / tooling artefacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend artefacts that the build itself produces
node_modules/
web/dist/
web/.vite/

# Dev / docs / git
.git/
.github/
.vscode/
.idea/
docs/

# Curriculum source repos are large; include only runtime flashcard assets.
curriculum/sources/**
!curriculum/sources/
!curriculum/sources/computer-science-flash-cards/
curriculum/sources/computer-science-flash-cards/**
!curriculum/sources/computer-science-flash-cards/cards-jwasham.db
!curriculum/sources/computer-science-flash-cards/cards-jwasham-extreme.db
!curriculum/sources/interactive-coding-challenges/
curriculum/sources/interactive-coding-challenges/**
!curriculum/sources/interactive-coding-challenges/anki_cards/
curriculum/sources/interactive-coding-challenges/anki_cards/**
!curriculum/sources/interactive-coding-challenges/anki_cards/Coding.apkg
!curriculum/sources/system-design-primer/
curriculum/sources/system-design-primer/**
!curriculum/sources/system-design-primer/resources/
curriculum/sources/system-design-primer/resources/**
!curriculum/sources/system-design-primer/resources/flash_cards/
curriculum/sources/system-design-primer/resources/flash_cards/**
!curriculum/sources/system-design-primer/resources/flash_cards/OO Design.apkg
!curriculum/sources/system-design-primer/resources/flash_cards/System Design.apkg
!curriculum/sources/system-design-primer/resources/flash_cards/System Design Exercises.apkg

# Env files never go into images — env comes from Compose/Coolify injection.
.env
.env.*
!.env.example

# Other build artefacts
dist/
build/
*.egg-info/

# Local-only
.DS_Store
Thumbs.db
*.swp
